# Copy to .env and adjust. Never commit .env.

PORT=3000

# Long random string. Required in production.
SESSION_SECRET=change-me-to-a-long-random-string

# One-click sample accounts on the sign-in page. Must be false in production.
DEMO_MODE=true

# Shows the sign-in code on screen for local testing. Must be false in production.
DEV_SHOW_OTP=true

# Optional: lets Gemini reword recommendation reasons (paid API tier recommended).
# Leave empty to use the rules engine's own wording.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email for sign-in codes (Resend or Brevo). Without these, codes appear only in the server log.
# MAIL_FROM=no-reply@yourdomain.in
# RESEND_API_KEY=
# BREVO_API_KEY=

# Where the local SQLite database lives. Proof files go in an "uploads" folder beside it (or UPLOAD_DIR).
# DB_FILE=./data/ngrm.sqlite

# Production: the first admin account is created from these on start-up.
# ADMIN_EMAIL=you@example.org
# ADMIN_NAME=Your Name

# Production starts with an empty database (no sample people). Set this to true only for a public demo server.
# SEED_SAMPLE=false

# Set to true when the app runs behind a hosting proxy or load balancer.
# TRUST_PROXY=false

# NODE_ENV=production

# Required in production: shown on the privacy notice.
# ORG_NAME=Your organisation
# PRIVACY_CONTACT=privacy@yourdomain.in
